APP_NAME="Real Estate MVP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Taipei
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

# Switch to MariaDB/MySQL for the full multi-season dataset; SQLite
# struggles with random reads once the file is several GB.
# DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=real_estate_mvp
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REAL_ESTATE_OPEN_DATA_URL="https://plvr.land.moi.gov.tw/Download?fileName=lvr_landcsv.zip&type=zip"
